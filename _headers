# Cloudflare Pages _headers file
#
# Asegura Content-Type correcto para los Universal Links / App Links manifests.
# Apple iOS rechaza el AASA si no llega como application/json.
# Google Android es más permisivo pero también prefiere application/json.

/.well-known/apple-app-site-association
  Content-Type: application/json
  X-Content-Type-Options: nosniff

/.well-known/assetlinks.json
  Content-Type: application/json
  X-Content-Type-Options: nosniff

# app-ads.txt tiene que llegar como texto plano: el rastreador de Google lo
# descarta si el Content-Type dice otra cosa.
/app-ads.txt
  Content-Type: text/plain; charset=utf-8
  X-Content-Type-Options: nosniff
